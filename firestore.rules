rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Sistema compartido: cualquier usuario autenticado puede leer y escribir.
    // No hay multi-tenant; la base es una sola y la comparten todos.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
